@startuml diagrama-componentes
skinparam shadowing false
skinparam linetype ortho
skinparam ranksep 40
skinparam defaultFontSize 14
skinparam ArrowColor #111111
skinparam ArrowThickness 2

title Diagrama de Componentes (MVC)\nSistema de Moeda Estudantil

together {
  actor "Usuário" as U

  rectangle "<b>1. VIEW</b>\nLogin · Painel Aluno · Painel Professor · Painel Empresa" as V #AED6F1
  rectangle "<b>2. CONTROLLER</b>\nAuth · Aluno · Professor · Empresa · Vantagem · Transacao" as C #ABEBC6
  rectangle "<b>3. SERVICES (Model)</b>\nAuth · Aluno · Professor · Empresa · Vantagem\nMoeda · Resgate · Email" as S #F9E79F
  rectangle "<b>4. REPOSITORIES</b>\nUsuario · Aluno · Professor · Empresa\nVantagem · Transacao · Instituicao" as R #F5B7B1
  database "Banco de Dados" as DB
}

cloud "SMTP" as M

U -down-> V
V -down-> C
C -down-> S
S -down-> R
R -down-> DB
S --> M : e-mail

legend bottom
  |= # |= Camada |= O que faz |
  | 1 | View | Telas que o usuário vê |
  | 2 | Controller | Recebe a requisição HTTP |
  | 3 | Services | Regras (moedas, resgate, login) |
  | 4 | Repositories | Acesso ao banco |
  | — | SMTP | Envio de e-mails |
endlegend

@enduml
